# Supabase PostgreSQL 접속 문자열 (Drizzle 마이그레이션 및 Vitest가 사용)
# Supabase 대시보드 > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Supabase 공개 키 (Settings > API) — Realtime 구독용
NEXT_PUBLIC_SUPABASE_URL=https://bwdvzxuowebatbwncred.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_EHtoPbrJYCy8E2atE8b9rA_QH2xf0uj>

# 앱 베이스 URL (OAuth 콜백 URL 조립)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub OAuth App 자격증명 (Phase 4)
# GitHub > Settings > Developer settings > OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=<client-id>
GITHUB_CLIENT_SECRET=<client-secret>

# 개발자 콘솔 게이트 (FR-027·FR-028, trd.md §2.4)
# 이 키가 설정된 환경에서만 /api/dev/* 라우트가 등록된다.
# 게이트는 이것 하나다 — 페르소나 전환(/api/mock-auth)과 시계 오프셋 반영도 이 키와
# 유효한 modoo42_dev_console 쿠키에 종속된다. NODE_ENV는 판정에 쓰지 않는다.
# 쿠키 서명 키로도 쓰이므로 값을 바꾸면 발급된 콘솔 세션이 전부 무효가 된다.
# 설정 후 최초 1회 `pnpm sandbox:sync`로 dev_sandbox 스키마를 만든다.
# Vercel Production 스코프에는 설정하지 않는다 — 설정하면 운영 도메인에 콘솔이 열린다.
DEV_CONSOLE_PASSWORD=<dev-console-password>
